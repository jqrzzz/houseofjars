# Copy to .env.local for local development. Never commit real values.

# Public URL of the site (canonical links, sitemap, Open Graph).
# Defaults to https://www.houseofjars.la (the house's domain) when unset.
NEXT_PUBLIC_SITE_URL=https://www.houseofjars.la

# Anthropic API key for Shadow, the AI concierge (/api/concierge).
# Without it the concierge answers 503 {"error":"not_configured"} and the
# chat window shows the team's WhatsApp and email instead.
ANTHROPIC_API_KEY=

# Claude model used by the concierge. Change it here, not in code. The
# concierge uses adaptive thinking, the effort setting and server-side
# refusal fallbacks, so pick a current model that supports them.
CONCIERGE_MODEL=claude-opus-5

# The most Shadow may spend in a day on one server instance, in input-token
# equivalents (an output token counts as 5, a cache read as 0.1). Blank means
# 1000000, about US$5 a day at Claude Opus 5 list prices. When it is used up
# Shadow rests until midnight Vientiane time and the chat window shows the
# team's WhatsApp and email. 0 keeps Shadow resting. Also set a monthly spend
# limit on the Anthropic workspace: that is the account-wide ceiling.
CONCIERGE_DAILY_TOKEN_BUDGET=

# Shadow Check-in (the house's operations system) receives inquiries from the
# message form and the concierge, and booking requests from online booking on
# /book (docs/BOOKING_API.md). Both are required; without them /api/inquiry,
# /api/availability and /api/booking answer 503, and /book shows Booking.com,
# Agoda and the message form, which falls back to contact details. The pages
# read them when the site is built, so redeploy after setting them.
# SHADOW_API_URL is the base URL, e.g. https://shadow.example.com (no trailing path).
SHADOW_API_URL=
# The property's inbound key from Shadow ("sck_" + 43 characters). Server-side only.
SHADOW_INQUIRY_KEY=

# Where the team signs in to Shadow Check-in, e.g. https://shadow.example.com
# (read when the site is built). When set, the footer shows a small "Team sign
# in" link; blank hides it. Only https is used (plain http only on localhost).
SHADOW_APP_URL=

# Search engines (see docs/SEO.md). All optional; blank adds nothing.
# Verification tokens from Google Search Console and Bing Webmaster Tools
# (the "HTML tag" method). Paste the token, or the whole meta tag. Read when
# the site is built, so redeploy after setting them.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
# IndexNow key: 8 to 128 letters, digits or dashes (for example a UUID
# without its braces). The site serves it at /indexnow-key.txt, and
# `npm run indexnow` (run with the same value) tells Bing and the other
# IndexNow search engines that pages changed.
INDEXNOW_KEY=
